<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <UpstreamRoot Condition="'$(UpstreamRoot)' == '' and '$(PROBEORACLE_UPSTREAM_ROOT)' != ''">$(PROBEORACLE_UPSTREAM_ROOT)</UpstreamRoot>
    <UpstreamRoot Condition="'$(UpstreamRoot)' == ''">$(MSBuildThisFileDirectory)../../../upstream/jellyfin</UpstreamRoot>
    <ExpectedUpstreamCommit>b04614e18d2aeed8d3d3de920c381c6bd5b97bdb</ExpectedUpstreamCommit>
  </PropertyGroup>

  <Import Project="$(UpstreamRoot)/Directory.Packages.props" Condition="Exists('$(UpstreamRoot)/Directory.Packages.props')" />

  <ItemGroup>
    <ProjectReference Include="$(UpstreamRoot)/MediaBrowser.MediaEncoding/MediaBrowser.MediaEncoding.csproj" />
    <ProjectReference Include="$(UpstreamRoot)/src/Jellyfin.Extensions/Jellyfin.Extensions.csproj" />
  </ItemGroup>
</Project>
