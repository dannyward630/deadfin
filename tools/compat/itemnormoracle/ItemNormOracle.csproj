<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <UpstreamRoot Condition="'$(UpstreamRoot)' == '' and '$(ITEMNORMORACLE_UPSTREAM_ROOT)' != ''">$(ITEMNORMORACLE_UPSTREAM_ROOT)</UpstreamRoot>
    <UpstreamRoot Condition="'$(UpstreamRoot)' == ''">$(MSBuildThisFileDirectory)../../../upstream/jellyfin</UpstreamRoot>
    <ExpectedUpstreamCommit>b04614e18d2aeed8d3d3de920c381c6bd5b97bdb</ExpectedUpstreamCommit>
  </PropertyGroup>

  <Import Project="$(UpstreamRoot)/Directory.Packages.props" Condition="Exists('$(UpstreamRoot)/Directory.Packages.props')" />

  <ItemGroup>
    <PackageReference Include="Diacritics" Version="4.1.8" />
    <PackageReference Include="ICU4N" Version="60.1.0-alpha.356" />
    <PackageReference Include="ICU4N.Transliterator" Version="60.1.0-alpha.356" />
    <ProjectReference Include="$(UpstreamRoot)/src/Jellyfin.Extensions/Jellyfin.Extensions.csproj" />
    <ProjectReference Include="$(UpstreamRoot)/MediaBrowser.Model/MediaBrowser.Model.csproj" />
    <ProjectReference Include="$(UpstreamRoot)/MediaBrowser.Controller/MediaBrowser.Controller.csproj" />
  </ItemGroup>
</Project>
