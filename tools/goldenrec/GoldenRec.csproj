<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <UpstreamRoot Condition="'$(UpstreamRoot)' == '' and '$(GOLDENREC_UPSTREAM_ROOT)' != ''">$(GOLDENREC_UPSTREAM_ROOT)</UpstreamRoot>
    <UpstreamRoot Condition="'$(UpstreamRoot)' == ''">$(MSBuildThisFileDirectory)../../upstream/jellyfin</UpstreamRoot>
    <DirectoryPackagesPropsPath>$(UpstreamRoot)/Directory.Packages.props</DirectoryPackagesPropsPath>
    <CentralPackageVersionsFileImported Condition="Exists('$(UpstreamRoot)/Directory.Packages.props')">true</CentralPackageVersionsFileImported>
  </PropertyGroup>

  <Import Project="$(UpstreamRoot)/Directory.Packages.props" Condition="Exists('$(UpstreamRoot)/Directory.Packages.props')" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Moq" />
    <ProjectReference Include="$(UpstreamRoot)/MediaBrowser.Model/MediaBrowser.Model.csproj" />
    <ProjectReference Include="$(UpstreamRoot)/MediaBrowser.Controller/MediaBrowser.Controller.csproj" />
  </ItemGroup>
</Project>
