#!/usr/bin/env bash
# Resolve one immutable build identity. Release authority is the train tag.
set -euo pipefail
ref=${1:?ref required}
sha=$(git rev-parse HEAD)
semver='^(v)?(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
rc='^(v)?(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-rc\.([1-9][0-9]*)$'
case "$ref" in
  master|refs/heads/master)
    source_branch=master; publication_tag=$sha; version="dev-${sha:0:12}"; channel=master ;;
  train/*|refs/heads/train/*)
    source_branch=${ref#refs/heads/}; train=${source_branch#train/}
    [[ $train =~ $semver ]] || { echo 'train must name a finite X.Y.Z release' >&2; exit 1; }
    publication_tag="train-${train}-${sha}"; version="${train}-dev-${sha:0:12}"; channel=train ;;
  refs/tags/*)
    tag=${ref#refs/tags/}
    if [[ $tag =~ $semver ]]; then
      version=$tag; channel=release
    elif [[ $tag =~ $rc ]]; then
      version=${tag#v}; channel=rc
    else
      echo 'release tag must be X.Y.Z, vX.Y.Z, X.Y.Z-rc.N, or vX.Y.Z-rc.N' >&2; exit 1
    fi
    [[ $(git rev-parse "${ref}^{commit}") == "$sha" ]] || { echo 'tag and checkout differ' >&2; exit 1; }
    git merge-base --is-ancestor "$sha" refs/remotes/origin/master || { echo 'release commit is not on master' >&2; exit 1; }
    source_branch=$ref; publication_tag=$tag ;;
  *) echo 'unsupported publication ref' >&2; exit 1 ;;
esac
printf 'publication_tag=%s\nsource_branch=%s\ncommit_sha=%s\nversion=%s\nchannel=%s\n' "$publication_tag" "$source_branch" "$sha" "$version" "$channel"
